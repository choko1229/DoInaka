includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # ???????? max(???2.4)?
    # tests/ ????: Pest ??????????($this?expect()->not)? PHPStan ????????????????????????????(docs/decisions.md)
    level: max
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes

    ignoreErrors:
        # Laravel 標準の骨格(config/filesystems.php)の env() の型。アプリの実装ではないので手を入れない
        -
            identifier: argument.type
            path: config/filesystems.php
