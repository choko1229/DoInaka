# 開発用の本物のキー。これをコピーして .env.local を作り、値を入れる(.env.local はコミットしない)
# php artisan dev:import-secrets(APP_ENV=local のときだけ動く)が読み、settings に暗号化して入れる
# 空の行は読み飛ばす。Turnstile は Cloudflare のテスト用キー、メールは Mailpit を使うのでここには不要

# OpenRouter(https://openrouter.ai/settings/keys)。:free のモデルだけ使う
OPENROUTER_API_KEY=

# Google OAuth クライアント(種類: ウェブアプリ)。承認済みのリダイレクト URI に
# http://localhost:8080/auth/google/callback を登録しておく
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord の開発用チャンネルの Webhook URL(本番用とは別のチャンネル)
DISCORD_WEBHOOK_URL=
