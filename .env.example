APP_NAME="ド田舎.net"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=app
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Docker(docker-compose.yml)の接続先。本番はインストーラーが書き出す
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=doinaka
DB_USERNAME=doinaka
DB_PASSWORD=doinaka

# IP アドレスのハッシュ用の秘密鍵(設計書14章)。php artisan key:generate とは別に、長いランダムな文字列を入れる
IP_HASH_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# 開発では Mailpit(http://localhost:8025)。本番の SMTP は settings に保存する(mail.*)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@do-inaka.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
